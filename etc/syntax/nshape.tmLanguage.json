{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nytrix Shape",
  "fileTypes": [
    "nshape"
  ],
  "scopeName": "source.nytrix-shape",
  "patterns": [
    {
      "include": "#source-ny"
    },
    {
      "include": "#source-c"
    },
    {
      "include": "#source-python"
    },
    {
      "include": "#source-generic"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#shape"
    },
    {
      "include": "#field"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#identifier"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.number-sign.nytrix-shape",
          "match": "^\\s*#.*$"
        },
        {
          "name": "comment.line.double-slash.nytrix-shape",
          "match": "//.*$"
        }
      ]
    },
    "source-ny": {
      "patterns": [
        {
          "name": "meta.embedded.block.nytrix.nytrix-shape",
          "begin": "^(\\s*)(source)\\s+((?:ny|nytrix)[A-Za-z0-9_.-]*)\\s+(<<)('?)\\b(NY)\\5\\s*$",
          "beginCaptures": {
            "2": {
              "name": "keyword.control.source.nytrix-shape"
            },
            "3": {
              "name": "entity.name.section.nytrix-shape"
            },
            "4": {
              "name": "punctuation.definition.heredoc.nytrix-shape"
            },
            "5": {
              "name": "punctuation.definition.string.begin.nytrix-shape"
            },
            "6": {
              "name": "entity.name.tag.heredoc.nytrix-shape"
            }
          },
          "end": "^\\s*NY\\s*$",
          "endCaptures": {
            "0": {
              "name": "entity.name.tag.heredoc.nytrix-shape"
            }
          },
          "patterns": [
            {
              "include": "source.nytrix"
            }
          ]
        }
      ]
    },
    "source-c": {
      "patterns": [
        {
          "name": "meta.embedded.block.c.nytrix-shape",
          "begin": "^(\\s*)(source)\\s+((?:c|cc|cpp|cxx|h|hpp)[A-Za-z0-9_.+-]*)\\s+(<<)('?)\\b(C|CC|CPP)\\5\\s*$",
          "beginCaptures": {
            "2": {
              "name": "keyword.control.source.nytrix-shape"
            },
            "3": {
              "name": "entity.name.section.nytrix-shape"
            },
            "4": {
              "name": "punctuation.definition.heredoc.nytrix-shape"
            },
            "5": {
              "name": "punctuation.definition.string.begin.nytrix-shape"
            },
            "6": {
              "name": "entity.name.tag.heredoc.nytrix-shape"
            }
          },
          "end": "^\\s*(?:C|CC|CPP)\\s*$",
          "endCaptures": {
            "0": {
              "name": "entity.name.tag.heredoc.nytrix-shape"
            }
          },
          "patterns": [
            {
              "include": "source.c"
            }
          ]
        }
      ]
    },
    "source-python": {
      "patterns": [
        {
          "name": "meta.embedded.block.python.nytrix-shape",
          "begin": "^(\\s*)(source)\\s+((?:py|python)[A-Za-z0-9_.+-]*)\\s+(<<)('?)\\b(PY|PYTHON)\\5\\s*$",
          "beginCaptures": {
            "2": {
              "name": "keyword.control.source.nytrix-shape"
            },
            "3": {
              "name": "entity.name.section.nytrix-shape"
            },
            "4": {
              "name": "punctuation.definition.heredoc.nytrix-shape"
            },
            "5": {
              "name": "punctuation.definition.string.begin.nytrix-shape"
            },
            "6": {
              "name": "entity.name.tag.heredoc.nytrix-shape"
            }
          },
          "end": "^\\s*(?:PY|PYTHON)\\s*$",
          "endCaptures": {
            "0": {
              "name": "entity.name.tag.heredoc.nytrix-shape"
            }
          },
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        }
      ]
    },
    "source-generic": {
      "patterns": [
        {
          "name": "meta.embedded.block.other.nytrix-shape",
          "begin": "^(\\s*)(source)\\s+([A-Za-z0-9_.+-]+)\\s+(<<)('?)\\b([A-Za-z][A-Za-z0-9_-]*)\\5\\s*$",
          "beginCaptures": {
            "2": {
              "name": "keyword.control.source.nytrix-shape"
            },
            "3": {
              "name": "entity.name.section.nytrix-shape"
            },
            "4": {
              "name": "punctuation.definition.heredoc.nytrix-shape"
            },
            "5": {
              "name": "punctuation.definition.string.begin.nytrix-shape"
            },
            "6": {
              "name": "entity.name.tag.heredoc.nytrix-shape"
            }
          },
          "end": "^\\s*[A-Za-z][A-Za-z0-9_-]*\\s*$",
          "endCaptures": {
            "0": {
              "name": "entity.name.tag.heredoc.nytrix-shape"
            }
          },
          "patterns": [
            {
              "include": "#string"
            },
            {
              "include": "#number"
            }
          ]
        }
      ]
    },
    "shape": {
      "patterns": [
        {
          "name": "meta.shape.declaration.nytrix-shape",
          "match": "\\b(shape)\\s+([A-Za-z_][A-Za-z0-9_.-]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.shape.nytrix-shape"
            },
            "2": {
              "name": "entity.name.type.shape.nytrix-shape"
            }
          }
        }
      ]
    },
    "field": {
      "patterns": [
        {
          "name": "meta.shape.field.nytrix-shape",
          "match": "^\\s*(family|generator|features|weights|balanced|optimizer|memory|strings|state|fast_rank|template|expect|expect_message|expect_code|expect_regex|source)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.field.nytrix-shape"
            }
          }
        }
      ]
    },
    "constant": {
      "patterns": [
        {
          "name": "constant.language.boolean.nytrix-shape",
          "match": "\\b(?:true|false|null|nil)\\b"
        },
        {
          "name": "constant.language.expectation.nytrix-shape",
          "match": "\\b(?:compile_and_run|compile_fail|run_fail|parse_fail|ny-test-case|ny-compile-fail|ny-run-fail|perf-real|stress|error|negative|diagnostic|checksum|c-vs-ny|perf)\\b"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.nytrix-shape",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nytrix-shape",
              "match": "\\\\(?:[0abfnrtv\\\\'\"n]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.single.nytrix-shape",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.nytrix-shape",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.nytrix-shape",
          "match": "\\b-?0x[0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.float.nytrix-shape",
          "match": "\\b-?(?:\\d[\\d_]*\\.\\d[\\d_]*|\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*))\\b"
        },
        {
          "name": "constant.numeric.integer.nytrix-shape",
          "match": "\\b-?\\d[\\d_]*\\b"
        }
      ]
    },
    "identifier": {
      "patterns": [
        {
          "name": "variable.other.symbol.nytrix-shape",
          "match": "\\b[A-Za-z_][A-Za-z0-9_.-]*\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.braces.nytrix-shape",
          "match": "[{}\\[\\](),:]"
        },
        {
          "name": "keyword.operator.assignment.nytrix-shape",
          "match": "="
        }
      ]
    }
  }
}
