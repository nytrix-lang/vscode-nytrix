{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nytrix",
  "fileTypes": [
    "ny"
  ],
  "scopeName": "source.nytrix",
  "patterns": [
    {
      "include": "#shebang"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#attribute"
    },
    {
      "include": "#embedded-string"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#module"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#type"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#function"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "shebang": {
      "patterns": [
        {
          "name": "comment.line.shebang.nytrix",
          "match": "^#!.*$"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "meta.embedded.block.python.nytrix",
          "begin": "(;\\{)\\s*((?i)(?:python|py)\\b)?",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.comment.begin.nytrix" },
            "2": { "name": "entity.name.function.embedded.language.nytrix" }
          },
          "end": "\\};",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.nytrix" } },
          "patterns": [ { "include": "source.python" } ]
        },
        {
          "name": "meta.embedded.block.javascript.nytrix",
          "begin": "(;\\{)\\s*((?i)(?:javascript|js)\\b)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.comment.begin.nytrix" },
            "2": { "name": "entity.name.function.embedded.language.nytrix" }
          },
          "end": "\\};",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.nytrix" } },
          "patterns": [ { "include": "source.js" } ]
        },
        {
          "name": "meta.embedded.block.typescript.nytrix",
          "begin": "(;\\{)\\s*((?i)(?:typescript|ts)\\b)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.comment.begin.nytrix" },
            "2": { "name": "entity.name.function.embedded.language.nytrix" }
          },
          "end": "\\};",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.nytrix" } },
          "patterns": [ { "include": "source.ts" } ]
        },
        {
          "name": "meta.embedded.block.c.nytrix",
          "begin": "(;\\{)\\s*((?i)(?:c)\\b)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.comment.begin.nytrix" },
            "2": { "name": "entity.name.function.embedded.language.nytrix" }
          },
          "end": "\\};",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.nytrix" } },
          "patterns": [ { "include": "source.c" } ]
        },
        {
          "name": "meta.embedded.block.cpp.nytrix",
          "begin": "(;\\{)\\s*((?i)(?:cpp|c\\+\\+)\\b)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.comment.begin.nytrix" },
            "2": { "name": "entity.name.function.embedded.language.nytrix" }
          },
          "end": "\\};",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.nytrix" } },
          "patterns": [ { "include": "source.cpp" } ]
        },
        {
          "name": "meta.embedded.block.rust.nytrix",
          "begin": "(;\\{)\\s*((?i)(?:rust|rs)\\b)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.comment.begin.nytrix" },
            "2": { "name": "entity.name.function.embedded.language.nytrix" }
          },
          "end": "\\};",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.nytrix" } },
          "patterns": [ { "include": "source.rust" } ]
        },
        {
          "name": "meta.embedded.block.shell.nytrix",
          "begin": "(;\\{)\\s*((?i)(?:shell|bash|sh)\\b)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.comment.begin.nytrix" },
            "2": { "name": "entity.name.function.embedded.language.nytrix" }
          },
          "end": "\\};",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.nytrix" } },
          "patterns": [ { "include": "source.shell" } ]
        },
        {
          "name": "meta.embedded.block.json.nytrix",
          "begin": "(;\\{)\\s*((?i)(?:json|jsonc)\\b)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.comment.begin.nytrix" },
            "2": { "name": "entity.name.function.embedded.language.nytrix" }
          },
          "end": "\\};",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.nytrix" } },
          "patterns": [ { "include": "source.json" } ]
        },
        {
          "name": "meta.embedded.block.xml.nytrix",
          "begin": "(;\\{)\\s*((?i)(?:xml|html)\\b)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.comment.begin.nytrix" },
            "2": { "name": "entity.name.function.embedded.language.nytrix" }
          },
          "end": "\\};",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.nytrix" } },
          "patterns": [ { "include": "text.xml" } ]
        },
        {
          "name": "meta.embedded.block.nytrix.nytrix",
          "begin": "(;\\{)\\s*((?i)(?:ny|nytrix)\\b)?",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.comment.begin.nytrix" },
            "2": { "name": "entity.name.function.embedded.language.nytrix" }
          },
          "end": "\\};",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.nytrix" } },
          "patterns": [ { "include": "source.nytrix" } ]
        },
        {
          "name": "comment.block.braces.nytrix",
          "begin": ";\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.nytrix"
            }
          },
          "end": "\\};",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.nytrix"
            }
          }
        },
        {
          "name": "comment.block.nytrix",
          "begin": ";\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.nytrix"
            }
          },
          "end": "\\*;",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.nytrix"
            }
          }
        },
        {
          "name": "comment.line.semicolon.nytrix",
          "begin": ";",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.nytrix"
            }
          },
          "end": "$"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.include.nytrix",
          "match": "^\\s*(#)\\s*(include)\\s+((?:<[^>]+>)|(?:\"[^\"]+\"))",
          "captures": {
            "1": {
              "name": "punctuation.definition.directive.nytrix"
            },
            "2": {
              "name": "keyword.control.directive.include.nytrix"
            },
            "3": {
              "name": "string.other.include.nytrix"
            }
          }
        },
        {
          "name": "meta.preprocessor.define.nytrix",
          "match": "^\\s*(#)\\s*(define|link|line)\\b.*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.directive.nytrix"
            },
            "2": {
              "name": "keyword.control.directive.nytrix"
            }
          }
        }
      ]
    },
    "attribute": {
      "patterns": [
        {
          "name": "storage.modifier.attribute.nytrix",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "escape": {
      "patterns": [
        {
          "name": "constant.character.escape.nytrix",
          "match": "\\\\(?:[0abfnrtv\\\\'\"n]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
        },
        {
          "name": "invalid.illegal.escape.nytrix",
          "match": "\\\\."
        }
      ]
    },
    "embedded-string": {
      "patterns": [
        {
          "name": "meta.embedded.inline.shader.nytrix",
          "begin": "(?:\\b(?:shader|glsl|wgsl|hlsl|msl|metal)\\s*\\(\\s*|\\b(?:def|mut)\\s+[A-Za-z_][A-Za-z0-9_]*_(?:shader|glsl|wgsl|hlsl|msl|metal|frag|vert)\\s*=\\s*)(\"\"\"|''')",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.nytrix"
            }
          },
          "end": "\\1",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nytrix"
            }
          },
          "patterns": [
            {
              "include": "source.nytrix-shader"
            }
          ]
        },
        {
          "name": "meta.embedded.inline.shader.nytrix",
          "begin": "(?:\\b(?:shader|glsl|wgsl|hlsl|msl|metal)\\s*\\(\\s*|\\b(?:def|mut)\\s+[A-Za-z_][A-Za-z0-9_]*_(?:shader|glsl|wgsl|hlsl|msl|metal|frag|vert)\\s*=\\s*)([\"'])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.nytrix"
            }
          },
          "end": "(?<!\\\\)(?:\\\\\\\\)*\\K\\1",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nytrix"
            }
          },
          "patterns": [
            {
              "include": "source.nytrix-shader"
            }
          ]
        },
        {
          "name": "meta.embedded.inline.asm.nytrix",
          "begin": "(?:\\b(asm|nasm|gas|masm)(\\s*\\(\\s*)|\\b(?:def|mut)\\s+[A-Za-z_][A-Za-z0-9_]*(?:_(?:asm|assembly|disasm|opcode|ops|s)|(?:Asm|Assembly))\\s*=\\s*)([\"'])",
          "beginCaptures": {
            "1": {
              "name": "support.function.builtin.nytrix"
            },
            "3": {
              "name": "punctuation.definition.string.begin.nytrix"
            }
          },
          "end": "(?<!\\\\)(?:\\\\\\\\)*\\K\\3",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nytrix"
            }
          },
          "patterns": [
            {
              "include": "#embedded-asm-content"
            }
          ]
        },
        {
          "name": "meta.embedded.inline.json.nytrix",
          "begin": "(?:\\b(?:json|from_json|to_json)\\s*\\(\\s*|\\b(?:def|mut)\\s+[A-Za-z_][A-Za-z0-9_]*_(?:json|jsonc)\\s*=\\s*)([\"'])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.nytrix"
            }
          },
          "end": "(?<!\\\\)(?:\\\\\\\\)*\\K\\1",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nytrix"
            }
          },
          "patterns": [
            {
              "include": "#embedded-json-content"
            }
          ]
        },
        {
          "name": "meta.embedded.inline.xml.nytrix",
          "begin": "(?:\\b(?:xml|html|svg)\\s*\\(\\s*|\\b(?:def|mut)\\s+[A-Za-z_][A-Za-z0-9_]*_(?:xml|html|svg)\\s*=\\s*)([\"'])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.nytrix"
            }
          },
          "end": "(?<!\\\\)(?:\\\\\\\\)*\\K\\1",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nytrix"
            }
          },
          "patterns": [
            {
              "include": "#embedded-xml-content"
            }
          ]
        },
        {
          "name": "meta.embedded.inline.yaml.nytrix",
          "begin": "(?:\\b(?:yaml)\\s*\\(\\s*|\\b(?:def|mut)\\s+[A-Za-z_][A-Za-z0-9_]*_(?:yaml|yml)\\s*=\\s*)([\"'])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.nytrix"
            }
          },
          "end": "(?<!\\\\)(?:\\\\\\\\)*\\K\\1",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nytrix"
            }
          },
          "patterns": [
            {
              "include": "#embedded-yaml-content"
            }
          ]
        },
        {
          "name": "meta.embedded.inline.ini.nytrix",
          "begin": "(?:\\b(?:ini|toml|properties)\\s*\\(\\s*|\\b(?:def|mut)\\s+[A-Za-z_][A-Za-z0-9_]*_(?:ini|toml|properties)\\s*=\\s*)([\"'])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.nytrix"
            }
          },
          "end": "(?<!\\\\)(?:\\\\\\\\)*\\K\\1",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nytrix"
            }
          },
          "patterns": [
            {
              "include": "#embedded-ini-content"
            }
          ]
        },
        {
          "name": "meta.embedded.inline.sql.nytrix",
          "begin": "(?:\\b(?:sql)\\s*\\(\\s*|\\b(?:def|mut)\\s+[A-Za-z_][A-Za-z0-9_]*_(?:sql|query)\\s*=\\s*)([\"'])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.nytrix"
            }
          },
          "end": "(?<!\\\\)(?:\\\\\\\\)*\\K\\1",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nytrix"
            }
          },
          "patterns": [
            {
              "include": "#embedded-sql-content"
            }
          ]
        },
        {
          "name": "meta.embedded.inline.regex.nytrix",
          "begin": "(?:\\b(?:regex)\\s*\\(\\s*|\\b(?:def|mut)\\s+[A-Za-z_][A-Za-z0-9_]*_(?:regex|re)\\s*=\\s*)([\"'])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.nytrix"
            }
          },
          "end": "(?<!\\\\)(?:\\\\\\\\)*\\K\\1",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nytrix"
            }
          },
          "patterns": [
            {
              "include": "#embedded-regex-content"
            }
          ]
        }
      ]
    },
    "embedded-asm-content": {
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "name": "comment.line.asm.nytrix",
          "match": "(?:;|//).*$"
        },
        {
          "name": "entity.name.label.asm.nytrix",
          "match": "^\\s*[A-Za-z_.$][A-Za-z0-9_.$]*:"
        },
        {
          "name": "keyword.control.asm.nytrix",
          "match": "\\b(?:mov|movq|movl|movzx|movsx|lea|add|sub|mul|imul|div|idiv|inc|dec|cmp|test|jmp|je|jne|jg|jge|jl|jle|ja|jae|jb|jbe|call|ret|push|pop|ldr|ldp|ldrb|ldrh|ldrsw|str|stp|adr|adrp|and|orr|eor|xor|bic|lsl|lsr|asr|ror|nop|svc|syscall|int|ud2|db|dw|dd|dq|byte|word|dword|qword|section|global|globl|extern)\\b"
        },
        {
          "name": "variable.language.register.asm.nytrix",
          "match": "(?:%[A-Za-z][A-Za-z0-9]*|\\$(?:[0-9]+|[A-Za-z_][A-Za-z0-9_]*)|\\b(?:r(?:[0-9]|1[0-5]|ax|bx|cx|dx|si|di|sp|bp)|e(?:ax|bx|cx|dx|si|di|sp|bp)|[abcd][lh]|rip|rsp|rbp|x(?:[0-9]|[12][0-9]|3[01])|w(?:[0-9]|[12][0-9]|3[01])|sp|lr|pc)\\b)"
        },
        {
          "name": "constant.numeric.asm.nytrix",
          "match": "(?:#-?[0-9]+|-?0x[0-9A-Fa-f]+|\\b-?[0-9]+\\b)"
        },
        {
          "name": "punctuation.separator.asm.nytrix",
          "match": "[\\[\\](),:]"
        },
        {
          "name": "storage.modifier.directive.asm.nytrix",
          "match": "\\.[A-Za-z_.$][A-Za-z0-9_.$]*"
        }
      ]
    },
    "embedded-json-content": {
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "name": "support.type.property-name.json.nytrix",
          "match": "\\\\\"(?:[^\"\\\\]|\\\\.)*\\\\\"(?=\\s*:)"
        },
        {
          "name": "string.quoted.double.json.nytrix",
          "match": "\\\\\"(?:[^\"\\\\]|\\\\.)*\\\\\""
        },
        {
          "name": "constant.language.json.nytrix",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "constant.numeric.json.nytrix",
          "match": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "punctuation.separator.dictionary.json.nytrix",
          "match": "[{}\\[\\],:]"
        }
      ]
    },
    "embedded-xml-content": {
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "name": "comment.block.xml.nytrix",
          "begin": "<!--",
          "end": "-->"
        },
        {
          "name": "entity.name.tag.xml.nytrix",
          "match": "</?[A-Za-z_:][A-Za-z0-9:._-]*"
        },
        {
          "name": "entity.other.attribute-name.xml.nytrix",
          "match": "\\b[A-Za-z_:][A-Za-z0-9:._-]*(?=\\s*=)"
        },
        {
          "name": "string.quoted.double.xml.nytrix",
          "match": "\\\\\"(?:[^\"\\\\]|\\\\.)*\\\\\""
        },
        {
          "name": "constant.character.entity.xml.nytrix",
          "match": "&[A-Za-z0-9#]+;"
        },
        {
          "name": "punctuation.definition.tag.xml.nytrix",
          "match": "[<>/=]"
        }
      ]
    },
    "embedded-yaml-content": {
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "name": "comment.line.yaml.nytrix",
          "match": "#.*$"
        },
        {
          "name": "keyword.other.mapping.yaml.nytrix",
          "match": "^[ \\t-]*[A-Za-z_][A-Za-z0-9_.-]*(?=\\s*:)"
        },
        {
          "name": "punctuation.definition.sequence.yaml.nytrix",
          "match": "^[ \\t]*-"
        },
        {
          "name": "constant.language.yaml.nytrix",
          "match": "\\b(?:true|false|null|yes|no|on|off)\\b"
        },
        {
          "name": "constant.numeric.yaml.nytrix",
          "match": "-?\\b\\d+(?:\\.\\d+)?\\b"
        },
        {
          "name": "punctuation.separator.mapping.yaml.nytrix",
          "match": ":"
        }
      ]
    },
    "embedded-ini-content": {
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "name": "comment.line.ini.nytrix",
          "match": "(?:;|#).*$"
        },
        {
          "name": "entity.name.section.ini.nytrix",
          "match": "^\\s*\\[[^\\]\\n]+\\]"
        },
        {
          "name": "keyword.other.definition.ini.nytrix",
          "match": "\\b[A-Za-z0-9_.-]+(?=\\s*=)"
        },
        {
          "name": "punctuation.separator.key-value.ini.nytrix",
          "match": "="
        }
      ]
    },
    "embedded-sql-content": {
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "name": "keyword.control.sql.nytrix",
          "match": "\\b(?:select|from|where|join|inner|left|right|full|outer|on|group|by|order|limit|insert|into|values|update|set|delete|create|table|alter|drop|distinct|union|having|case|when|then|else|end|and|or|not|as|desc|asc)\\b"
        },
        {
          "name": "string.quoted.single.sql.nytrix",
          "match": "'(?:[^'\\\\]|\\\\.)*'"
        },
        {
          "name": "constant.numeric.sql.nytrix",
          "match": "-?\\b\\d+(?:\\.\\d+)?\\b"
        },
        {
          "name": "punctuation.separator.sql.nytrix",
          "match": "[(),.;]"
        }
      ]
    },
    "embedded-regex-content": {
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "name": "keyword.operator.anchor.regex.nytrix",
          "match": "(?:\\^|\\$|\\\\b|\\\\B)"
        },
        {
          "name": "keyword.operator.quantifier.regex.nytrix",
          "match": "(?:\\*|\\+|\\?|\\{\\d+(?:,\\d*)?\\})"
        },
        {
          "name": "keyword.operator.alternation.regex.nytrix",
          "match": "\\|"
        },
        {
          "name": "punctuation.definition.group.regex.nytrix",
          "match": "[()\\[\\]]"
        },
        {
          "name": "constant.other.character-class.regex.nytrix",
          "match": "\\\\[dDsSwW]"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.interpolated.triple.double.nytrix",
          "begin": "\\bf\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nytrix"
            }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nytrix"
            }
          },
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "name": "meta.interpolation.nytrix",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.interpolated.triple.single.nytrix",
          "begin": "\\bf'''",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nytrix"
            }
