          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Extra arguments passed to ny-lsp."
        },
        "nytrix.debugAdapter.path": {
          "type": "string",
          "default": "",
          "description": "Explicit path to ny-dap. Empty means auto-detect from workspace builds, NYTRIX_DAP, bootstrap roots, or PATH."
        },
        "nytrix.debugAdapter.arguments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Extra arguments passed to the Nytrix debug adapter."
        },
        "nytrix.debug.compilerArguments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Extra compiler arguments used for debug builds before -O0 -g -o."
        },
        "nytrix.debug.dwarfVersion": {
          "type": "number",
          "default": 0,
          "description": "DWARF version for ny-dap launches. 0 lets the compiler choose."
        },
        "nytrix.debug.debugLocals": {
          "type": "boolean",
          "default": false,
          "description": "Emit fuller local/argument debug info for ny-dap launches. This can improve variables/evaluate fidelity but the safer default is off."
        },
        "nytrix.debug.justMyCode": {
          "type": "boolean",
          "default": true,
          "description": "Hide runtime scaffolding and prefer user/workspace frames in stack traces and debug backtraces."
        },
        "nytrix.debug.traceRuntime": {
          "type": "boolean",
          "default": false,
          "description": "Enable Nytrix runtime call tracing in ny-dap launches."
        },
        "nytrix.debug.traceValues": {
          "type": "boolean",
          "default": false,
          "description": "Include traced return values in ny-dap launches."
        },
        "nytrix.debug.traceVerbose": {
          "type": "boolean",
          "default": false,
          "description": "Include fine-grained traced source locations in ny-dap launches."
        },
        "nytrix.debug.traceFilter": {
          "type": "string",
          "default": "",
          "description": "Optional function-name filter for ny-dap debug runtime tracing."
        },
        "nytrix.debug.outputDir": {
          "type": "string",
          "default": "",
          "description": "Directory for temporary debug ELFs. Empty uses .nytrix-cache/vscode-debug under the workspace."
