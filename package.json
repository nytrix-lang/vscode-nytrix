          "default": "https://github.com/nytrix-lang/nytrix",
          "description": "Git repository cloned by Nytrix: Install Toolchain."
        },
        "nytrix.bootstrap.ref": {
          "type": "string",
          "default": "main",
          "description": "Branch, tag, or ref name fetched by Nytrix: Install Toolchain."
