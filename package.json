        "icon": "$(references)"
      },
      {
        "command": "nytrix.renameSymbol",
        "title": "Nytrix: Rename Symbol",
        "category": "Nytrix",
        "icon": "$(edit)"
      },
      {
        "command": "nytrix.showHover",
        "title": "Nytrix: Show Hover",
        "category": "Nytrix",
        "icon": "$(info)"
      },
      {
        "command": "nytrix.showSignatureHelp",
        "title": "Nytrix: Show Signature Help",
        "category": "Nytrix",
        "icon": "$(symbol-parameter)"
      },
      {
        "command": "nytrix.gotoDocumentSymbol",
        "title": "Nytrix: Go to Symbol in File",
        "category": "Nytrix",
        "icon": "$(symbol-method)"
      },
      {
        "command": "nytrix.gotoWorkspaceSymbol",
        "title": "Nytrix: Go to Symbol in Workspace",
        "category": "Nytrix",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "nytrix.navigateBack",
        "title": "Nytrix: Go Back",
        "category": "Nytrix",
        "icon": "$(arrow-left)"
      },
      {
        "command": "nytrix.navigateForward",
        "title": "Nytrix: Go Forward",
        "category": "Nytrix",
        "icon": "$(arrow-right)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "nytrix.showActions",
          "when": "resourceLangId == nytrix",
          "group": "navigation@0"
        },
        {
          "command": "nytrix.startRepl",
          "when": "resourceLangId == nytrix",
          "group": "navigation@1.5"
        },
        {
          "command": "nytrix.pickRunMode",
          "when": "resourceLangId == nytrix",
          "group": "navigation@1.7"
        },
        {
          "command": "nytrix.runFile",
          "when": "resourceLangId == nytrix",
          "group": "navigation@1"
        },
        {
          "command": "nytrix.debugFile",
          "when": "resourceLangId == nytrix",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
