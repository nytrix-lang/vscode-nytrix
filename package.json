{
  "name": "nytrix",
  "icon": "logo.png",
  "publisher": "x3ric",
  "version": "0.2.0",
  "displayName": "Nytrix",
  "description": "Nytrix language support: syntax, real ny-lsp/ny-dap integration, run/test, and tooling.",
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Formatters"
  ],
  "keywords": [
    "nytrix",
    "ny",
    "lsp",
    "language-server"
  ],
  "author": "x3ric",
  "license": "MIT",
  "homepage": "https://github.com/nytrix-lang/nytrix",
  "repository": {
    "type": "git",
    "url": "https://github.com/nytrix-lang/nytrix.git"
  },
  "bugs": "https://github.com/nytrix-lang/nytrix/issues",
  "qna": "https://github.com/nytrix-lang/nytrix/issues",
  "galleryBanner": {
    "color": "#0D1117",
    "theme": "dark"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting and static editor features work. Running, debugging, formatting, tests, bootstrap, and tool commands require a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "main": "./src/extension.js",
  "scripts": {
    "check": "node --check src/extension.js && node --check scripts/package.js",
    "validate": "npm run check",
    "prepackage": "npm run validate",
    "package": "node etc/scripts/package.js",
    "package:ls": "node etc/scripts/package.js --list"
  },
  "activationEvents": [
    "onLanguage:nytrix",
    "onLanguage:nshape",
    "onCommand:nytrix.pickProcess",
    "onDebug",
    "onDebugResolve:nytrix",
    "onDebugInitialConfigurations:nytrix",
    "onDebugDynamicConfigurations:nytrix",
    "onTaskType:nytrix"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nytrix",
        "aliases": [
          "Nytrix",
          "nytrix",
          "ny"
        ],
        "extensions": [
          ".ny"
        ],
        "configuration": "./etc/syntax/language-configuration.json"
      },
      {
        "id": "nshape",
        "aliases": [
          "Nytrix Shape",
          "NShape",
          "nshape"
        ],
        "extensions": [
          ".nshape"
        ],
        "configuration": "./etc/syntax/nshape-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nytrix",
        "scopeName": "source.nytrix",
        "path": "./etc/syntax/nytrix.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.inline.asm.nytrix": "asm",
          "meta.embedded.inline.ini.nytrix": "ini",
          "meta.embedded.inline.json.nytrix": "json",
          "meta.embedded.inline.regex.nytrix": "regexp",
          "meta.embedded.inline.sql.nytrix": "sql",
          "meta.embedded.inline.xml.nytrix": "xml",
          "meta.embedded.inline.yaml.nytrix": "yaml",
          "meta.embedded.block.python.nytrix": "python",
          "meta.embedded.block.javascript.nytrix": "javascript",
          "meta.embedded.block.typescript.nytrix": "typescript",
          "meta.embedded.block.c.nytrix": "c",
          "meta.embedded.block.cpp.nytrix": "cpp",
          "meta.embedded.block.rust.nytrix": "rust",
          "meta.embedded.block.shell.nytrix": "shellscript",
          "meta.embedded.block.json.nytrix": "json",
          "meta.embedded.block.xml.nytrix": "xml",
          "meta.embedded.block.nytrix.nytrix": "nytrix"
        }
      },
      {
        "language": "nshape",
        "scopeName": "source.nytrix-shape",
        "path": "./etc/syntax/nshape.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.nytrix.nytrix-shape": "nytrix",
          "meta.embedded.block.c.nytrix-shape": "c",
          "meta.embedded.block.python.nytrix-shape": "python",
          "source.nytrix": "nytrix",
          "source.c": "c",
          "source.python": "python"
        }
      },
      {
        "scopeName": "source.nytrix-shader",
        "path": "./etc/syntax/shader.tmLanguage.json"
      },
      {
        "scopeName": "markdown.nytrix.codeblock",
        "path": "./etc/syntax/markdown-nytrix.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.nytrix": "nytrix",
          "source.nytrix": "nytrix"
        }
      }
    ],
    "snippets": [
      {
        "language": "nytrix",
        "path": "./etc/snippets/nytrix.code-snippets"
      },
      {
        "language": "nshape",
        "path": "./etc/snippets/nshape.code-snippets"
      }
    ],
    "commands": [
