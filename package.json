    "submenus": [
      {
        "id": "nytrix.runDebug",
        "label": "Run / Debug",
        "icon": "$(play)"
      },
      {
        "id": "nytrix.tools",
        "label": "Tools",
        "icon": "$(tools)"
      },
      {
        "id": "nytrix.navigation",
        "label": "Navigation",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "nytrix.showActions",
          "when": "resourceLangId == nytrix",
          "group": "navigation@0"
        },
        {
          "command": "nytrix.startRepl",
          "when": "resourceLangId == nytrix",
          "group": "navigation@1.5"
        },
        {
          "command": "nytrix.pickRunMode",
          "when": "resourceLangId == nytrix",
          "group": "navigation@1.7"
        },
        {
          "command": "nytrix.runFile",
          "when": "resourceLangId == nytrix",
          "group": "navigation@1"
        },
        {
          "command": "nytrix.debugFile",
          "when": "resourceLangId == nytrix",
          "group": "navigation@2"
        },
        {
          "command": "nytrix.runShape",
          "when": "resourceLangId == nshape",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "nytrix.runDebug",
          "when": "resourceLangId == nytrix || resourceLangId == nshape",
          "group": "1_modification@1"
        },
        {
          "submenu": "nytrix.tools",
          "when": "resourceLangId == nytrix",
          "group": "1_modification@2"
        },
        {
          "submenu": "nytrix.navigation",
          "when": "resourceLangId == nytrix",
          "group": "navigation@1"
        }
      ],
      "nytrix.runDebug": [
        {
          "command": "nytrix.runSelection",
          "when": "resourceLangId == nytrix && editorHasSelection",
          "group": "1_run@1"
        },
        {
          "command": "nytrix.sendSelectionToRepl",
          "when": "resourceLangId == nytrix",
          "group": "1_run@2"
        },
        {
          "command": "nytrix.debugFile",
          "when": "resourceLangId == nytrix",
          "group": "2_debug@1"
        },
        {
          "command": "nytrix.runShape",
          "when": "resourceLangId == nshape",
          "group": "1_run@1"
        },
        {
          "command": "nytrix.runShapeSuite",
          "when": "resourceLangId == nshape",
          "group": "1_run@2"
        }
      ],
      "nytrix.tools": [
        {
          "command": "nytrix.checkFile",
          "when": "resourceLangId == nytrix",
          "group": "1_check@1"
        },
        {
          "command": "nytrix.analyzeFile",
          "when": "resourceLangId == nytrix",
          "group": "1_check@2"
        },
        {
          "command": "nytrix.expandFile",
          "when": "resourceLangId == nytrix",
          "group": "2_modify@1"
        },
        {
          "command": "nytrix.traceFile",
          "when": "resourceLangId == nytrix",
          "group": "2_modify@2"
        },
        {
          "command": "nytrix.profileFile",
          "when": "resourceLangId == nytrix",
          "group": "2_modify@3"
        },
        {
          "command": "nytrix.formatFile",
          "when": "resourceLangId == nytrix",
          "group": "3_format@1"
        },
        {
          "command": "nytrix.optimizeFile",
          "when": "resourceLangId == nytrix",
          "group": "3_format@2"
        }
      ],
      "nytrix.navigation": [
        {
          "command": "nytrix.goToDefinition",
          "when": "resourceLangId == nytrix",
          "group": "1_def@1"
        },
        {
          "command": "nytrix.peekDefinition",
          "when": "resourceLangId == nytrix",
          "group": "1_def@2"
        },
        {
          "command": "nytrix.findDefinitionByName",
          "when": "resourceLangId == nytrix",
          "group": "1_def@3"
        },
        {
          "command": "nytrix.findReferences",
