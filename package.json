    "debuggers": [
      {
        "type": "nytrix",
        "label": "Nytrix",
        "program": "./src/nytrixDebugAdapter.js",
        "runtime": "node",
        "languages": [
          "nytrix"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Nytrix source file to debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Program arguments."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory.",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "description": "Environment variables for the debug adapter or debuggee."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Ask the debug adapter to stop at entry.",
                "default": false
              },
              "trace": {
                "type": "boolean",
                "description": "Enable verbose adapter tracing when supported.",
                "default": false
              },
              "dapPath": {
                "type": "string",
                "description": "Path to a Nytrix Debug Adapter Protocol server. Falls back to nytrix.debugAdapter.path or NYTRIX_DAP."
              },
              "dapArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra arguments passed to the Nytrix debug adapter."
              },
              "nyPath": {
                "type": "string",
                "description": "Path to ny for adapters that need the compiler."
              },
              "gdbPath": {
                "type": "string",
                "description": "Path to gdb for the built-in Nytrix native debug adapter."
              },
              "compilerArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra compiler arguments before -O0 -g -o <debug-binary>."
              },
              "debugLocals": {
                "type": "boolean",
                "description": "Emit richer local/argument debug info. Safer default is false because some builds are more stable without it.",
                "default": false
              },
              "justMyCode": {
                "type": "boolean",
                "description": "Prefer user/workspace frames in stack traces and hide runtime scaffolding by default.",
                "default": true
              },
              "traceRuntime": {
                "type": "boolean",
                "description": "Compile and run with Nytrix runtime call tracing enabled.",
                "default": false
              },
              "traceValues": {
                "type": "boolean",
                "description": "Print traced return values for matching function calls.",
                "default": false
              },
              "traceVerbose": {
                "type": "boolean",
                "description": "Also print fine-grained traced source locations.",
                "default": false
              },
              "traceFilter": {
                "type": "string",
                "description": "Optional function-name filter for runtime tracing. Accepts comma-separated substrings or prefix* patterns.",
                "default": ""
              },
              "outputDir": {
                "type": "string",
                "description": "Directory for temporary debug ELFs."
              },
              "sourceFileMap": {
                "type": "object",
                "description": "Map debug info source roots to local workspace roots, for example {\"/build/root\": \"${workspaceFolder}\"}."
              }
            }
          },
          "attach": {
            "required": [
              "processId"
            ],
            "properties": {
              "processId": {
                "type": [
                  "number",
                  "string"
                ],
                "description": "Process id to attach to. Use ${command:nytrix.pickProcess} for a picker."
              },
              "program": {
                "type": "string",
                "description": "Optional executable path, used by gdb for symbols."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory.",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "description": "Environment variables for the debug adapter."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Keep the process stopped after attach.",
                "default": true
              },
              "trace": {
                "type": "boolean",
                "description": "Enable verbose adapter tracing.",
                "default": false
              },
              "gdbPath": {
                "type": "string",
                "description": "Path to gdb for the built-in Nytrix native debug adapter."
              },
              "sourceFileMap": {
                "type": "object",
                "description": "Map debug info source roots to local workspace roots."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "nytrix",
            "request": "launch",
            "name": "Nytrix: Debug Current File",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "args": [],
            "stopOnEntry": false,
            "traceRuntime": false,
            "traceValues": false,
            "traceVerbose": false,
            "traceFilter": "",
            "debugLocals": false,
            "justMyCode": true,
            "compilerArgs": []
          },
          {
            "type": "nytrix",
            "request": "attach",
            "name": "Nytrix: Attach to Process",
            "processId": "${command:nytrix.pickProcess}",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Nytrix: Debug current file",
            "description": "Debug the active Nytrix file through the built-in gdb/MI adapter.",
            "body": {
              "type": "nytrix",
              "request": "launch",
              "name": "Nytrix: Debug ${fileBasename}",
              "program": "${file}",
              "cwd": "${workspaceFolder}",
              "args": [],
              "stopOnEntry": false,
              "traceRuntime": false,
              "traceValues": false,
              "traceVerbose": false,
              "traceFilter": "",
              "debugLocals": false,
              "justMyCode": true,
              "compilerArgs": []
            }
          },
          {
            "label": "Nytrix: Attach to process",
            "description": "Attach the built-in gdb/MI adapter to a running Nytrix process.",
            "body": {
              "type": "nytrix",
              "request": "attach",
              "name": "Nytrix: Attach",
              "processId": "${command:nytrix.pickProcess}",
              "cwd": "${workspaceFolder}",
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "nytrix",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "Nytrix task id: check, run, expand, trace, dump-ast, dump-llvm, dump-stats, format, analyze, tests, profile."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "nytrix",
        "owner": "nytrix",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(?:\\[[^\\]]+\\]\\s+)?(?:(warning|error|note):?\\s+)?(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "configuration": {
      "title": "Nytrix",
      "properties": {
        "nytrix.path": {
          "type": "string",
          "default": "",
          "description": "Path to the ny compiler. Empty means auto-detect from workspace, ~/nytrix, environment, then PATH."
        },
        "nytrix.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start ny-lsp for .ny files when it can be found."
        },
        "nytrix.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to ny-lsp. Empty means auto-detect from workspace, ~/nytrix, environment, then PATH."
        },
        "nytrix.bootstrap.mode": {
          "type": "string",
          "enum": [
            "prompt",
            "auto",
            "off"
          ],
          "default": "prompt",
          "markdownDescription": "How the extension should recover when `ny` or `ny-lsp` is missing. `prompt` asks before cloning/building the official Nytrix repo or setting paths, `auto` prompts as soon as a missing tool is needed, and `off` disables bootstrap unless you run `Nytrix: Install Toolchain` yourself."
        },
        "nytrix.bootstrap.root": {
          "type": "string",
          "default": "${home}/.local/share/nytrix",
          "description": "Install/update root for the extension-managed Nytrix checkout."
        },
        "nytrix.bootstrap.repo": {
          "type": "string",
          "default": "https://github.com/nytrix-lang/nytrix",
          "description": "Git repository cloned by Nytrix: Install Toolchain."
        },
        "nytrix.bootstrap.ref": {
          "type": "string",
          "default": "main",
          "description": "Branch, tag, or ref name fetched by Nytrix: Install Toolchain."
        },
        "nytrix.lsp.arguments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Extra arguments passed to ny-lsp."
        },
        "nytrix.debugAdapter.path": {
          "type": "string",
          "default": "",
          "description": "Path to an external Nytrix Debug Adapter Protocol server. Used when nytrix.debugAdapter.useInternal is false."
        },
        "nytrix.debugAdapter.useInternal": {
          "type": "boolean",
          "default": true,
          "description": "Use the built-in gdb/MI-backed Nytrix DAP adapter. Disable to use nytrix.debugAdapter.path or NYTRIX_DAP."
        },
        "nytrix.debugAdapter.arguments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Extra arguments passed to the Nytrix debug adapter."
        },
        "nytrix.debug.gdbPath": {
          "type": "string",
          "default": "",
          "description": "Path to gdb for the built-in native debug adapter. Empty means PATH."
        },
        "nytrix.debug.compilerArguments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Extra compiler arguments used for debug builds before -O0 -g -o."
        },
        "nytrix.debug.dwarfVersion": {
          "type": "number",
          "default": 0,
          "description": "DWARF version for built-in debug launches. 0 lets the compiler choose."
        },
        "nytrix.debug.debugLocals": {
          "type": "boolean",
          "default": false,
          "description": "Emit fuller local/argument debug info for built-in debug launches. This can improve variables/evaluate fidelity but the safer default is off."
        },
        "nytrix.debug.justMyCode": {
          "type": "boolean",
          "default": true,
          "description": "Hide runtime scaffolding and prefer user/workspace frames in stack traces and debug backtraces."
        },
        "nytrix.debug.traceRuntime": {
          "type": "boolean",
          "default": false,
          "description": "Enable Nytrix runtime call tracing in built-in debug launches."
        },
        "nytrix.debug.traceValues": {
          "type": "boolean",
          "default": false,
          "description": "Include traced return values in built-in debug launches."
        },
        "nytrix.debug.traceVerbose": {
          "type": "boolean",
          "default": false,
          "description": "Include fine-grained traced source locations in built-in debug launches."
        },
        "nytrix.debug.traceFilter": {
          "type": "string",
          "default": "",
          "description": "Optional function-name filter for built-in debug runtime tracing."
        },
        "nytrix.debug.outputDir": {
          "type": "string",
          "default": "",
          "description": "Directory for temporary debug ELFs. Empty uses build/cache/vscode-dap under the workspace."
        },
        "nytrix.debug.sourceFileMap": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Default source path map for debugger sessions. Keys are debug-info/source roots, values are local roots."
        },
        "nytrix.test.runtimeSuitePath": {
          "type": "string",
          "default": "etc/tests/rt",
          "description": "Runtime test suite path passed to ny-test."
        },
        "nytrix.run.arguments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Extra arguments passed after the current file when running Nytrix."
        },
        "nytrix.run.cwd": {
          "type": "string",
          "default": "",
          "description": "Working directory for run/check/expand commands. Empty uses the workspace folder or file directory."
        },
        "nytrix.run.mode": {
          "type": "string",
          "enum": [
            "terminal",
            "output",
            "repl"
          ],
          "default": "terminal",
          "markdownDescription": "How `Run File` and `Run Selection` behave. `terminal` uses the shared integrated terminal, `output` streams into the Nytrix output channel, and `repl` sends the file/selection into the persistent Nytrix REPL."
        },
        "nytrix.run.useIntegratedTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Legacy terminal toggle for run commands. When nytrix.run.mode is output, the output channel is always used."
        },
        "nytrix.run.reuseTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Reuse one Nytrix integrated terminal for run/test/profile commands instead of opening a new terminal every time."
        },
        "nytrix.repl.cwd": {
          "type": "string",
          "default": "",
          "description": "Working directory for the persistent Nytrix REPL. Empty uses the active workspace or file directory."
        },
        "nytrix.repl.arguments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Extra arguments appended after -i when starting the persistent Nytrix REPL."
        },
        "nytrix.repl.usePlain": {
          "type": "boolean",
          "default": false,
          "description": "Start the persistent REPL with --plain-repl for the simplest possible terminal behavior."
        },
        "nytrix.repl.revealTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the REPL terminal whenever the extension starts it or sends code into it."
        },
        "nytrix.check.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Use fallback compiler diagnostics on save only when ny-lsp is unavailable."
        },
        "nytrix.analyze.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Run ny-fmt analyzer hints on save and surface style / maintainability / optimization guidance alongside compiler diagnostics."
        },
        "nytrix.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show compact Run/Check/Expand/REPL/Debug action lenses at the top of Nytrix files."
        },
        "nytrix.errorLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render compact inline Nytrix diagnostics after the affected line, alongside squiggles and Problems entries."
        },
        "nytrix.errorLens.includeHints": {
          "type": "boolean",
          "default": true,
          "description": "Include analyzer hints and notes in the inline Nytrix diagnostic lens, not just errors and warnings."
        },
        "nytrix.errorLens.maxItems": {
          "type": "number",
          "default": 40,
          "minimum": 0,
          "description": "Maximum inline Nytrix diagnostics to render in one editor at a time."
        },
        "nytrix.output.reveal": {
          "type": "string",
          "enum": [
            "errors",
            "always",
            "never"
          ],
          "default": "errors",
          "markdownDescription": "When to reveal the shared Nytrix output channel for extension-run commands. `errors` shows it only on failures unless a command explicitly needs streamed output."
        },
        "nytrix.output.clearBeforeRun": {
          "type": "boolean",
          "default": false,
          "description": "Clear the Nytrix output channel before each new command block instead of appending a timestamped history."
        },
        "nytrix.env": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables added to Nytrix tool processes."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2"
  }
}
