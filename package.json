{
  "name": "nytrix",
  "icon": "logo.png",
  "publisher": "x3ric",
  "version": "0.1.0",
  "displayName": "Nytrix",
  "description": "Nytrix language support: syntax, LSP diagnostics, run/debug, and tooling.",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "nytrix",
    "ny",
    "lsp",
    "language-server"
  ],
  "author": "x3ric",
  "license": "MIT",
  "homepage": "https://github.com/nytrix-lang/nytrix",
  "repository": {
    "type": "git",
    "url": "https://github.com/nytrix-lang/nytrix.git"
  },
  "bugs": "https://github.com/nytrix-lang/nytrix/issues",
  "engines": {
    "vscode": "^1.84.0"
  },
  "main": "./src/extension.js",
  "files": [
    "src/**",
    "snippets/**",
    "language-configuration.json",
    "nshape-language-configuration.json",
    "nytrix.tmLanguage.json",
    "nshape.tmLanguage.json",
    "markdown-nytrix.tmLanguage.json",
    "README.md",
    "DETAILS.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "logo.png",
    "node_modules/**"
  ],
  "scripts": {
    "check": "node --check src/extension.js && node --check src/nytrixDebugAdapter.js",
    "package": "vsce package"
  },
  "activationEvents": [
    "onLanguage:nytrix",
    "onLanguage:nynth-shape",
    "onCommand:nytrix.runFile",
    "onCommand:nytrix.showActions",
    "onCommand:nytrix.showOutput",
    "onCommand:nytrix.clearOutput",
    "onCommand:nytrix.pickRunMode",
    "onCommand:nytrix.pickOutputReveal",
    "onCommand:nytrix.startRepl",
    "onCommand:nytrix.focusRepl",
    "onCommand:nytrix.resetRepl",
    "onCommand:nytrix.clearRepl",
    "onCommand:nytrix.sendSelectionToRepl",
    "onCommand:nytrix.runFileInRepl",
    "onCommand:nytrix.loadFileInRepl",
    "onCommand:nytrix.runSelection",
    "onCommand:nytrix.checkFile",
    "onCommand:nytrix.debugFile",
    "onCommand:nytrix.expandFile",
    "onCommand:nytrix.formatFile",
    "onCommand:nytrix.optimizeFile",
    "onCommand:nytrix.analyzeFile",
    "onCommand:nytrix.traceFile",
    "onCommand:nytrix.dumpAst",
    "onCommand:nytrix.dumpLlvm",
    "onCommand:nytrix.dumpStats",
    "onCommand:nytrix.runTests",
    "onCommand:nytrix.profileFile",
    "onCommand:nytrix.restartLsp",
    "onCommand:nytrix.installToolchain",
    "onCommand:nytrix.showToolchain",
    "onCommand:nytrix.pickProcess",
    "onDebug",
    "onDebugResolve:nytrix",
    "onDebugInitialConfigurations:nytrix",
    "onDebugDynamicConfigurations:nytrix",
    "onTaskType:nytrix",
    "onCommand:nytrix.goToDefinition",
    "onCommand:nytrix.peekDefinition",
    "onCommand:nytrix.findDefinitionByName",
    "onCommand:nytrix.findReferences",
    "onCommand:nytrix.renameSymbol",
    "onCommand:nytrix.showHover",
    "onCommand:nytrix.showSignatureHelp",
    "onCommand:nytrix.gotoDocumentSymbol",
    "onCommand:nytrix.gotoWorkspaceSymbol",
    "onCommand:nytrix.navigateBack",
    "onCommand:nytrix.navigateForward"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nytrix",
        "aliases": [
          "Nytrix",
          "nytrix",
          "ny"
        ],
        "extensions": [
          ".ny"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "nynth-shape",
        "aliases": [
          "Nynth Shape",
          "nshape"
        ],
        "extensions": [
          ".nshape"
        ],
        "configuration": "./nshape-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nytrix",
        "scopeName": "source.nytrix",
        "path": "./nytrix.tmLanguage.json"
      },
      {
        "language": "nynth-shape",
        "scopeName": "source.nynth-shape",
        "path": "./nshape.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.nytrix.nynth-shape": "nytrix",
          "meta.embedded.block.c.nynth-shape": "c"
        }
      },
      {
        "scopeName": "markdown.nytrix.codeblock",
        "path": "./markdown-nytrix.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.nytrix": "nytrix",
          "source.nytrix": "nytrix",
          "meta.embedded.block.nynth-shape": "nynth-shape",
          "source.nynth-shape": "nynth-shape"
        }
      }
    ],
    "snippets": [
      {
        "language": "nytrix",
        "path": "./snippets/nytrix.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "nytrix.showActions",
        "title": "Nytrix: Show Actions",
        "category": "Nytrix",
        "icon": "$(tools)"
      },
      {
        "command": "nytrix.showOutput",
        "title": "Nytrix: Show Output",
        "category": "Nytrix",
        "icon": "$(output)"
      },
      {
        "command": "nytrix.clearOutput",
        "title": "Nytrix: Clear Output",
        "category": "Nytrix",
        "icon": "$(clear-all)"
      },
      {
        "command": "nytrix.pickRunMode",
        "title": "Nytrix: Set Run Mode",
        "category": "Nytrix",
        "icon": "$(settings-gear)"
      },
      {
        "command": "nytrix.pickOutputReveal",
        "title": "Nytrix: Set Output Reveal Mode",
        "category": "Nytrix",
        "icon": "$(eye)"
      },
      {
        "command": "nytrix.startRepl",
        "title": "Nytrix: Start REPL",
        "category": "Nytrix",
        "icon": "$(terminal)"
      },
      {
        "command": "nytrix.focusRepl",
        "title": "Nytrix: Focus REPL",
        "category": "Nytrix",
        "icon": "$(terminal-view-icon)"
      },
      {
        "command": "nytrix.resetRepl",
        "title": "Nytrix: Reset REPL",
        "category": "Nytrix",
        "icon": "$(debug-restart)"
      },
      {
        "command": "nytrix.clearRepl",
        "title": "Nytrix: Clear REPL",
        "category": "Nytrix",
        "icon": "$(clear-all)"
      },
      {
        "command": "nytrix.sendSelectionToRepl",
        "title": "Nytrix: Send Selection to REPL",
        "category": "Nytrix",
        "icon": "$(arrow-small-right)"
      },
      {
        "command": "nytrix.runFileInRepl",
        "title": "Nytrix: Run File in REPL",
        "category": "Nytrix",
        "icon": "$(play-circle)"
      },
      {
        "command": "nytrix.loadFileInRepl",
        "title": "Nytrix: Load File in REPL",
        "category": "Nytrix",
        "icon": "$(symbol-file)"
      },
      {
        "command": "nytrix.runFile",
        "title": "Nytrix: Run File",
        "category": "Nytrix",
        "icon": "$(play)"
      },
      {
        "command": "nytrix.runSelection",
        "title": "Nytrix: Run Selection",
        "category": "Nytrix",
        "icon": "$(run)"
      },
      {
        "command": "nytrix.checkFile",
        "title": "Nytrix: Check File",
        "category": "Nytrix",
        "icon": "$(pass)"
      },
      {
        "command": "nytrix.debugFile",
        "title": "Nytrix: Debug File",
        "category": "Nytrix",
        "icon": "$(debug-alt)"
      },
      {
        "command": "nytrix.expandFile",
        "title": "Nytrix: Expand File",
        "category": "Nytrix",
        "icon": "$(symbol-key)"
      },
      {
        "command": "nytrix.formatFile",
        "title": "Nytrix: Format File",
        "category": "Nytrix",
        "icon": "$(symbol-keyword)"
      },
      {
        "command": "nytrix.optimizeFile",
        "title": "Nytrix: Optimize File",
        "category": "Nytrix",
        "icon": "$(rocket)"
      },
      {
        "command": "nytrix.analyzeFile",
        "title": "Nytrix: Analyze File",
        "category": "Nytrix",
        "icon": "$(search)"
      },
      {
        "command": "nytrix.traceFile",
        "title": "Nytrix: Trace File",
        "category": "Nytrix",
        "icon": "$(bug)"
      },
      {
        "command": "nytrix.dumpAst",
        "title": "Nytrix: Dump AST",
        "category": "Nytrix",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "nytrix.dumpLlvm",
        "title": "Nytrix: Dump LLVM",
        "category": "Nytrix",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "nytrix.dumpStats",
        "title": "Nytrix: Dump Compile Stats",
        "category": "Nytrix",
        "icon": "$(graph)"
      },
      {
        "command": "nytrix.runTests",
        "title": "Nytrix: Run Runtime Tests",
        "category": "Nytrix",
        "icon": "$(testing-run-all)"
      },
      {
        "command": "nytrix.profileFile",
        "title": "Nytrix: Profile File",
        "category": "Nytrix",
        "icon": "$(pulse)"
      },
      {
        "command": "nytrix.restartLsp",
        "title": "Nytrix: Restart Language Server",
        "category": "Nytrix",
        "icon": "$(debug-restart)"
      },
      {
        "command": "nytrix.installToolchain",
        "title": "Nytrix: Install Toolchain",
        "category": "Nytrix",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nytrix.showToolchain",
        "title": "Nytrix: Show Toolchain",
        "category": "Nytrix",
        "icon": "$(terminal)"
      },
      {
        "command": "nytrix.goToDefinition",
