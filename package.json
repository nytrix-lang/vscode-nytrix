          "description": "Path to the ny compiler. Empty means auto-detect from workspace, ~/nytrix, environment, then PATH."
        },
        "nytrix.inlayHints.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show type inference inlay hints in the editor."
        },
        "nytrix.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start ny-lsp for .ny files when it can be found."
        },
        "nytrix.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to ny-lsp. Empty means auto-detect from workspace, ~/nytrix, environment, then PATH."
        },
        "nytrix.doc.path": {
          "type": "string",
          "default": "",
          "description": "Path to ny-doc. Empty means auto-detect from workspace, ~/nytrix, environment, then PATH."
