{
  "name": "nytrix",
  "displayName": "Nytrix",
  "description": "Nytrix language support through the toolchain's own ny-lsp and ny-dap.",
  "version": "0.2.1",
  "publisher": "x3ric",
  "author": "x3ric",
  "license": "MIT",
  "icon": "logo.png",
  "homepage": "https://github.com/nytrix-lang/nytrix",
  "repository": {
    "type": "git",
    "url": "https://github.com/nytrix-lang/vscode-nytrix.git"
  },
  "bugs": "https://github.com/nytrix-lang/vscode-nytrix/issues",
  "galleryBanner": {
    "color": "#0D1117",
    "theme": "dark"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Formatters"
  ],
  "keywords": [
    "nytrix",
    "ny",
    "lsp",
    "dap"
  ],
  "engines": {
    "vscode": "^1.84.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Highlighting works everywhere. The language server, commands and debugging start only in trusted workspaces because they run toolchain executables."
    }
  },
  "main": "./src/extension.js",
  "activationEvents": [],
  "scripts": {
    "sync": "node src/scripts/sync.js",
    "check": "node src/scripts/check.js",
    "test": "node src/scripts/check.js",
    "package": "node src/scripts/package.js",
    "package:ls": "node src/scripts/package.js --list"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "nytrix.commands",
        "title": "Show Commands",
        "category": "Nytrix",
        "icon": "$(list-selection)"
      },
      {
        "command": "nytrix.restartServer",
        "title": "Restart Server",
        "category": "Nytrix",
        "icon": "$(debug-restart)"
      },
      {
        "command": "nytrix.showOutput",
        "title": "Show Output",
        "category": "Nytrix",
        "icon": "$(output)"
      },
      {
        "command": "nytrix.showToolchain",
        "title": "Show Toolchain",
        "category": "Nytrix",
        "icon": "$(tools)"
      },
      {
        "command": "nytrix.ui.run",
        "title": "Run File",
        "category": "Nytrix",
        "icon": "$(play)"
      },
      {
        "command": "nytrix.ui.shape",
        "title": "Run Shape",
        "category": "Nytrix",
        "icon": "$(play)"
      },
      {
        "command": "nytrix.ui.debug",
        "title": "Debug File",
        "category": "Nytrix",
        "icon": "$(debug-alt)"
      },
      {
        "command": "nytrix.ui.check",
        "title": "Check File",
        "category": "Nytrix",
        "icon": "$(check)"
      },
      {
        "command": "nytrix.ui.trace",
        "title": "Trace File",
        "category": "Nytrix",
        "icon": "$(list-flat)"
      },
      {
        "command": "nytrix.ui.expand",
        "title": "Expand Macros",
        "category": "Nytrix",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "nytrix.ui.ast",
        "title": "Show AST",
        "category": "Nytrix",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "nytrix.ui.llvm",
        "title": "Show LLVM IR",
        "category": "Nytrix",
        "icon": "$(file-code)"
      },
      {
        "command": "nytrix.ui.stats",
        "title": "Compile Stats",
        "category": "Nytrix",
        "icon": "$(graph)"
      },
      {
        "command": "nytrix.ui.analyze",
        "title": "Analyze File",
        "category": "Nytrix",
        "icon": "$(search)"
      },
      {
        "command": "nytrix.ui.optimize",
        "title": "Optimize File",
        "category": "Nytrix",
        "icon": "$(zap)"
      },
      {
        "command": "nytrix.ui.profile",
        "title": "Profile File",
        "category": "Nytrix",
        "icon": "$(dashboard)"
      },
      {
        "command": "nytrix.ui.repl",
        "title": "Start REPL",
        "category": "Nytrix",
        "icon": "$(terminal)"
      },
      {
        "command": "nytrix.ui.tests",
        "title": "Run Tests",
        "category": "Nytrix",
        "icon": "$(beaker)"
      },
      {
        "command": "nytrix.ui.docs",
        "title": "Search Docs",
        "category": "Nytrix",
        "icon": "$(book)"
      }
    ],
    "keybindings": [
      {
        "command": "nytrix.commands",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "nytrix.ui.run",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "(editorLangId == nytrix)"
      },
      {
        "command": "nytrix.ui.shape",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "(editorLangId == nshape)"
      }
    ],
    "configuration": {
      "title": "Nytrix",
      "properties": {
        "nytrix.toolchain": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Directory containing `ny-lsp` and `ny-dap` (for example `~/nytrix/build/release`), or the path to one of them. Empty: `NYTRIX_HOME`, `PATH`, then `build/release` in the workspace."
        },
        "nytrix.server.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments for `ny-lsp`."
        },
        "nytrix.server.environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Extra environment variables for `ny-lsp` and `ny-dap`."
        },
        "nytrix.debugger": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Native DAP debugger used by `ny-dap` (`gdb` 14+ or `lldb-dap`). Empty: `ny-dap` picks one from `PATH`."
        },
        "nytrix.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "markdownDescription": "Log language-server traffic to the Nytrix output channel."
        }
      }
    },
    "languages": [
      {
        "id": "nytrix",
        "aliases": [
          "Nytrix",
          "nytrix",
          "ny"
        ],
        "extensions": [
          ".ny"
        ],
        "configuration": "./language/configuration/nytrix.json"
      },
      {
        "id": "nshape",
        "aliases": [
          "Nytrix Shape",
          "NShape",
          "nshape"
        ],
        "extensions": [
          ".nshape"
        ],
        "configuration": "./language/configuration/nshape.json"
      }
    ],
    "grammars": [
      {
        "language": "nytrix",
        "scopeName": "source.nytrix",
        "path": "./language/syntaxes/nytrix.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.inline.asm.nytrix": "asm",
          "meta.embedded.inline.ini.nytrix": "ini",
          "meta.embedded.inline.json.nytrix": "json",
          "meta.embedded.inline.regex.nytrix": "regexp",
          "meta.embedded.inline.sql.nytrix": "sql",
          "meta.embedded.inline.xml.nytrix": "xml",
          "meta.embedded.inline.yaml.nytrix": "yaml",
          "meta.embedded.block.python.nytrix": "python",
          "meta.embedded.block.javascript.nytrix": "javascript",
          "meta.embedded.block.typescript.nytrix": "typescript",
          "meta.embedded.block.c.nytrix": "c",
          "meta.embedded.block.cpp.nytrix": "cpp",
          "meta.embedded.block.rust.nytrix": "rust",
          "meta.embedded.block.shell.nytrix": "shellscript",
          "meta.embedded.block.json.nytrix": "json",
          "meta.embedded.block.xml.nytrix": "xml",
          "meta.embedded.block.nytrix.nytrix": "nytrix"
        }
      },
      {
        "language": "nshape",
        "scopeName": "source.nytrix-shape",
        "path": "./language/syntaxes/nshape.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.nytrix.nytrix-shape": "nytrix",
          "meta.embedded.block.c.nytrix-shape": "c",
          "meta.embedded.block.python.nytrix-shape": "python",
          "source.nytrix": "nytrix",
          "source.c": "c",
          "source.python": "python"
        }
      },
      {
        "scopeName": "source.nytrix-shader",
        "path": "./language/syntaxes/shader.tmLanguage.json"
      },
      {
        "scopeName": "markdown.nytrix.codeblock",
        "path": "./language/syntaxes/markdown-nytrix.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.nytrix": "nytrix",
          "source.nytrix": "nytrix"
        }
      }
    ],
    "snippets": [
      {
        "language": "nytrix",
        "path": "./language/snippets/nytrix.code-snippets"
      },
      {
        "language": "nshape",
        "path": "./language/snippets/nshape.code-snippets"
      }
    ],
    "breakpoints": [
      {
        "language": "nytrix"
      },
      {
        "language": "nshape"
      }
    ],
    "debuggers": [
      {
        "type": "nytrix",
        "label": "Nytrix",
        "languages": [
          "nytrix",
          "nshape"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "default": "${file}",
                "description": "Program, .ny file or .nshape fixture; ny-dap builds sources with debug info."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string",
                "default": "${fileDirname}"
              },
              "env": {
                "type": "object",
                "default": {}
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "compilerArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Extra compiler flags for the debug build."
              },
              "sourceLine": {
                "type": "number",
                "description": "Line selecting the source ny block of an .nshape fixture."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "nytrix",
            "request": "launch",
            "name": "Nytrix: Debug File",
            "program": "${file}",
            "cwd": "${fileDirname}"
          }
        ]
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nytrix.ui.run",
          "when": "(editorLangId == nytrix)"
        },
        {
          "command": "nytrix.ui.shape",
          "when": "(editorLangId == nshape)"
        },
        {
          "command": "nytrix.ui.debug",
          "when": "(editorLangId == nytrix || editorLangId == nshape)"
        },
        {
          "command": "nytrix.ui.check",
          "when": "(editorLangId == nytrix)"
        },
        {
          "command": "nytrix.ui.trace",
          "when": "(editorLangId == nytrix)"
        },
        {
          "command": "nytrix.ui.expand",
          "when": "(editorLangId == nytrix)"
        },
        {
          "command": "nytrix.ui.ast",
          "when": "(editorLangId == nytrix)"
        },
        {
          "command": "nytrix.ui.llvm",
          "when": "(editorLangId == nytrix)"
        },
        {
          "command": "nytrix.ui.stats",
          "when": "(editorLangId == nytrix)"
        },
        {
          "command": "nytrix.ui.analyze",
          "when": "(editorLangId == nytrix)"
        },
        {
          "command": "nytrix.ui.optimize",
          "when": "(editorLangId == nytrix)"
        },
        {
          "command": "nytrix.ui.profile",
          "when": "(editorLangId == nytrix)"
        },
        {
          "command": "nytrix.ui.repl",
          "when": "(editorLangId == nytrix || editorLangId == nshape)"
        },
        {
          "command": "nytrix.ui.tests",
          "when": "workspaceFolderCount > 0 || (editorLangId == nytrix || editorLangId == nshape)"
        },
        {
          "command": "nytrix.ui.docs",
          "when": "workspaceFolderCount > 0 || (editorLangId == nytrix || editorLangId == nshape)"
        }
      ],
      "editor/title/run": [
        {
          "command": "nytrix.ui.run",
          "when": "(editorLangId == nytrix) && !inDebugMode",
          "group": "1_run@0"
        },
        {
          "command": "nytrix.ui.shape",
          "when": "(editorLangId == nshape) && !inDebugMode",
          "group": "1_run@1"
        },
        {
          "command": "nytrix.ui.debug",
          "when": "(editorLangId == nytrix || editorLangId == nshape) && !inDebugMode",
          "group": "1_run@2"
        }
      ],
      "editor/context": [
        {
          "submenu": "nytrix.tools",
          "when": "(editorLangId == nytrix || editorLangId == nshape)",
          "group": "navigation@9"
        }
      ],
      "explorer/context": [
        {
          "command": "nytrix.ui.run",
          "when": "!explorerResourceIsFolder && (resourceExtname == .ny)",
          "group": "nytrix@0"
        },
        {
          "command": "nytrix.ui.shape",
          "when": "!explorerResourceIsFolder && (resourceExtname == .nshape)",
          "group": "nytrix@1"
        },
        {
          "command": "nytrix.ui.debug",
          "when": "!explorerResourceIsFolder && (resourceExtname == .ny || resourceExtname == .nshape)",
          "group": "nytrix@2"
        }
      ],
      "nytrix.tools": [
        {
          "command": "nytrix.ui.check",
          "when": "(editorLangId == nytrix)",
          "group": "1_tools@3"
        },
        {
          "command": "nytrix.ui.trace",
          "when": "(editorLangId == nytrix)",
          "group": "1_tools@4"
        },
        {
          "command": "nytrix.ui.expand",
          "when": "(editorLangId == nytrix)",
          "group": "1_tools@5"
        },
        {
          "command": "nytrix.ui.ast",
          "when": "(editorLangId == nytrix)",
          "group": "1_tools@6"
        },
        {
          "command": "nytrix.ui.llvm",
          "when": "(editorLangId == nytrix)",
          "group": "1_tools@7"
        },
        {
          "command": "nytrix.ui.stats",
          "when": "(editorLangId == nytrix)",
          "group": "1_tools@8"
        },
        {
          "command": "nytrix.ui.analyze",
          "when": "(editorLangId == nytrix)",
          "group": "1_tools@9"
        },
        {
          "command": "nytrix.ui.optimize",
          "when": "(editorLangId == nytrix)",
          "group": "1_tools@10"
        },
        {
          "command": "nytrix.ui.profile",
          "when": "(editorLangId == nytrix)",
          "group": "1_tools@11"
        },
        {
          "command": "nytrix.ui.repl",
          "when": "(editorLangId == nytrix || editorLangId == nshape)",
          "group": "1_tools@12"
        },
        {
          "command": "nytrix.ui.tests",
          "when": "(editorLangId == nytrix || editorLangId == nshape)",
          "group": "2_workspace@13"
        },
        {
          "command": "nytrix.ui.docs",
          "when": "(editorLangId == nytrix || editorLangId == nshape)",
          "group": "2_workspace@14"
        }
      ]
    },
    "submenus": [
      {
        "id": "nytrix.tools",
        "label": "Nytrix"
      }
    ]
  }
}
