{
  "name": "nytrix",
  "displayName": "Nytrix",
  "description": "Nytrix language support through the toolchain's own ny-lsp and ny-dap.",
  "version": "0.2.1",
  "publisher": "x3ric",
  "author": "x3ric",
  "license": "MIT",
  "icon": "logo.png",
  "homepage": "https://github.com/nytrix-lang/nytrix",
  "repository": {
    "type": "git",
    "url": "https://github.com/nytrix-lang/vscode-nytrix.git"
  },
  "bugs": "https://github.com/nytrix-lang/vscode-nytrix/issues",
  "galleryBanner": {
    "color": "#0D1117",
    "theme": "dark"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Formatters"
  ],
  "keywords": [
    "nytrix",
    "ny",
    "lsp",
    "dap"
  ],
  "engines": {
    "vscode": "^1.84.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Highlighting works everywhere. The language server, commands and debugging start only in trusted workspaces because they run toolchain executables."
    }
  },
  "main": "./src/extension.js",
  "activationEvents": [],
  "scripts": {
    "sync": "node src/scripts/sync.js",
    "check": "node src/scripts/check.js",
    "test": "node src/scripts/check.js",
    "package": "node src/scripts/package.js",
    "package:ls": "node src/scripts/package.js --list"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "nytrix.commands",
        "title": "Show Commands",
        "category": "Nytrix"
      },
      {
        "command": "nytrix.debugFile",
        "title": "Debug File",
        "category": "Nytrix"
      },
      {
        "command": "nytrix.restartServer",
        "title": "Restart Server",
        "category": "Nytrix"
      },
      {
        "command": "nytrix.showOutput",
        "title": "Show Output",
        "category": "Nytrix"
      },
      {
        "command": "nytrix.showToolchain",
        "title": "Show Toolchain",
        "category": "Nytrix"
      }
    ],
    "keybindings": [
      {
        "command": "nytrix.commands",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      }
    ],
    "configuration": {
      "title": "Nytrix",
      "properties": {
        "nytrix.toolchain": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Directory containing `ny-lsp` and `ny-dap` (for example `~/nytrix/build/release`), or the path to one of them. Empty: `NYTRIX_HOME`, `PATH`, then `build/release` in the workspace."
        },
        "nytrix.server.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments for `ny-lsp`."
        },
        "nytrix.server.environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Extra environment variables for `ny-lsp` and `ny-dap`."
        },
        "nytrix.debugger": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Native DAP debugger used by `ny-dap` (`gdb` 14+ or `lldb-dap`). Empty: `ny-dap` picks one from `PATH`."
        },
        "nytrix.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "markdownDescription": "Log language-server traffic to the Nytrix output channel."
        }
      }
    },
    "languages": [
      {
        "id": "nytrix",
        "aliases": [
          "Nytrix",
          "nytrix",
          "ny"
        ],
        "extensions": [
          ".ny"
        ],
        "configuration": "./language/configuration/nytrix.json"
      },
      {
        "id": "nshape",
        "aliases": [
          "Nytrix Shape",
          "NShape",
          "nshape"
        ],
        "extensions": [
          ".nshape"
        ],
        "configuration": "./language/configuration/nshape.json"
      }
    ],
    "grammars": [
      {
        "language": "nytrix",
        "scopeName": "source.nytrix",
        "path": "./language/syntaxes/nytrix.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.inline.asm.nytrix": "asm",
          "meta.embedded.inline.ini.nytrix": "ini",
          "meta.embedded.inline.json.nytrix": "json",
          "meta.embedded.inline.regex.nytrix": "regexp",
          "meta.embedded.inline.sql.nytrix": "sql",
          "meta.embedded.inline.xml.nytrix": "xml",
          "meta.embedded.inline.yaml.nytrix": "yaml",
          "meta.embedded.block.python.nytrix": "python",
          "meta.embedded.block.javascript.nytrix": "javascript",
          "meta.embedded.block.typescript.nytrix": "typescript",
          "meta.embedded.block.c.nytrix": "c",
          "meta.embedded.block.cpp.nytrix": "cpp",
          "meta.embedded.block.rust.nytrix": "rust",
          "meta.embedded.block.shell.nytrix": "shellscript",
          "meta.embedded.block.json.nytrix": "json",
          "meta.embedded.block.xml.nytrix": "xml",
          "meta.embedded.block.nytrix.nytrix": "nytrix"
        }
      },
      {
        "language": "nshape",
        "scopeName": "source.nytrix-shape",
        "path": "./language/syntaxes/nshape.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.nytrix.nytrix-shape": "nytrix",
          "meta.embedded.block.c.nytrix-shape": "c",
          "meta.embedded.block.python.nytrix-shape": "python",
          "source.nytrix": "nytrix",
          "source.c": "c",
          "source.python": "python"
        }
      },
      {
        "scopeName": "source.nytrix-shader",
        "path": "./language/syntaxes/shader.tmLanguage.json"
      },
      {
        "scopeName": "markdown.nytrix.codeblock",
        "path": "./language/syntaxes/markdown-nytrix.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.nytrix": "nytrix",
          "source.nytrix": "nytrix"
        }
      }
    ],
    "snippets": [
      {
        "language": "nytrix",
        "path": "./language/snippets/nytrix.code-snippets"
      },
      {
        "language": "nshape",
        "path": "./language/snippets/nshape.code-snippets"
      }
    ],
    "breakpoints": [
      {
        "language": "nytrix"
      },
      {
        "language": "nshape"
      }
    ],
    "debuggers": [
      {
        "type": "nytrix",
        "label": "Nytrix",
        "languages": [
          "nytrix",
          "nshape"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "default": "${file}",
                "description": "Program, .ny file or .nshape fixture; ny-dap builds sources with debug info."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string",
                "default": "${fileDirname}"
              },
              "env": {
                "type": "object",
                "default": {}
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "compilerArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Extra compiler flags for the debug build."
              },
              "sourceLine": {
                "type": "number",
                "description": "Line selecting the source ny block of an .nshape fixture."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "nytrix",
            "request": "launch",
            "name": "Nytrix: Debug File",
            "program": "${file}",
            "cwd": "${fileDirname}"
          }
        ]
      }
    ]
  }
}
