    "keybindings": [
      {
        "command": "nytrix.showActions",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorLangId == nytrix"
      },
      {
        "command": "nytrix.sendSelectionToRepl",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorLangId == nytrix"
      },
      {
