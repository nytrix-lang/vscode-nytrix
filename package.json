    "walkthroughs": [
      {
        "id": "nytrix.getStarted",
        "title": "Nytrix Setup",
        "description": "Set up the Nytrix toolchain, run code, inspect docs, and debug.",
        "steps": [
          {
            "id": "nytrix.toolchain",
            "title": "Set the Nytrix toolchain",
            "description": "Run **Nytrix: Show Toolchain** to inspect detected binaries, or **Nytrix: Install Toolchain** to clone and build the configured toolchain repository after approval.",
            "completionEvents": [
              "onCommand:nytrix.showToolchain",
              "onCommand:nytrix.installToolchain"
            ]
          },
          {
            "id": "nytrix.actions",
            "title": "Use the action picker",
            "description": "Open a `.ny` file and run **Nytrix: Show Actions** for run, check, format, debug, REPL, docs, and symbol navigation.",
            "completionEvents": [
              "onCommand:nytrix.showActions"
            ]
          },
          {
            "id": "nytrix.docs",
            "title": "Search docs and API",
            "description": "Use **Nytrix: Search Docs / API** or **Search Docs for Selection** to query `ny-doc` across stdlib modules, symbols, docs, and keywords.",
            "completionEvents": [
              "onCommand:nytrix.searchDocs",
              "onCommand:nytrix.searchDocsForSelection"
            ]
          },
          {
            "id": "nytrix.debug",
            "title": "Debug with ny-dap",
            "description": "Use **Nytrix: Debug File** for a launch config backed by the real `ny-dap`, or add a `nytrix` debug configuration from `launch.json`.",
            "completionEvents": [
              "onCommand:nytrix.debugFile"
            ]
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "nytrix"
      }
    ],
    "debuggers": [
      {
        "type": "nytrix",
        "label": "Nytrix",
        "languages": [
          "nytrix"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Nytrix source file to debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Program arguments."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory.",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "description": "Environment variables for the debug adapter or debuggee."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Ask the debug adapter to stop at entry.",
                "default": false
              },
              "trace": {
                "type": "boolean",
                "description": "Enable verbose adapter tracing when supported.",
                "default": false
              },
              "dapPath": {
                "type": "string",
                "description": "Explicit path to ny-dap for this session. Empty uses nytrix.debugAdapter.path, NYTRIX_DAP, workspace autodetect, bootstrap roots, or PATH."
              },
              "dapArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra arguments passed to the Nytrix debug adapter."
              },
              "nyPath": {
                "type": "string",
                "description": "Path to ny for adapters that need the compiler."
              },
              "compilerArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra compiler arguments before -O0 -g -o <debug-binary>."
              },
              "debugLocals": {
                "type": "boolean",
                "description": "Emit richer local/argument debug info. Safer default is false because some builds are more stable without it.",
                "default": false
              },
              "justMyCode": {
                "type": "boolean",
                "description": "Prefer user/workspace frames in stack traces and hide runtime scaffolding by default.",
                "default": true
              },
              "traceRuntime": {
                "type": "boolean",
                "description": "Compile and run with Nytrix runtime call tracing enabled.",
                "default": false
              },
              "traceValues": {
                "type": "boolean",
                "description": "Print traced return values for matching function calls.",
                "default": false
              },
              "traceVerbose": {
                "type": "boolean",
                "description": "Also print fine-grained traced source locations.",
                "default": false
              },
              "traceFilter": {
                "type": "string",
                "description": "Optional function-name filter for runtime tracing. Accepts comma-separated substrings or prefix* patterns.",
                "default": ""
              },
              "outputDir": {
                "type": "string",
                "description": "Directory for temporary debug ELFs."
              },
              "sourceFileMap": {
                "type": "object",
                "description": "Map debug info source roots to local workspace roots, for example {\"/build/root\": \"${workspaceFolder}\"}."
              }
            }
          },
          "attach": {
            "required": [
              "processId"
            ],
            "properties": {
              "processId": {
                "type": [
                  "number",
                  "string"
                ],
                "description": "Process id to attach to. Use ${command:nytrix.pickProcess} for a picker."
              },
              "program": {
                "type": "string",
                "description": "Optional executable or source path passed through to ny-dap for attach sessions."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory.",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "description": "Environment variables for the debug adapter."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Keep the process stopped after attach.",
                "default": true
              },
              "trace": {
                "type": "boolean",
                "description": "Enable verbose adapter tracing.",
                "default": false
              },
              "sourceFileMap": {
                "type": "object",
                "description": "Map debug info source roots to local workspace roots."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "nytrix",
            "request": "launch",
            "name": "Nytrix: Debug Current File",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "args": [],
            "stopOnEntry": false,
            "traceRuntime": false,
            "traceValues": false,
            "traceVerbose": false,
            "traceFilter": "",
            "debugLocals": false,
            "justMyCode": true,
            "compilerArgs": []
          },
          {
            "type": "nytrix",
            "request": "attach",
            "name": "Nytrix: Attach to Process",
            "processId": "${command:nytrix.pickProcess}",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Nytrix: Debug current file",
            "description": "Debug the active Nytrix file through ny-dap.",
            "body": {
              "type": "nytrix",
              "request": "launch",
              "name": "Nytrix: Debug ${fileBasename}",
              "program": "${file}",
              "cwd": "${workspaceFolder}",
              "args": [],
              "stopOnEntry": false,
              "traceRuntime": false,
              "traceValues": false,
              "traceVerbose": false,
              "traceFilter": "",
              "debugLocals": false,
              "justMyCode": true,
              "compilerArgs": []
            }
          },
          {
            "label": "Nytrix: Attach to process",
            "description": "Attach ny-dap to a running Nytrix process.",
            "body": {
              "type": "nytrix",
              "request": "attach",
              "name": "Nytrix: Attach",
              "processId": "${command:nytrix.pickProcess}",
              "cwd": "${workspaceFolder}",
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "nytrix",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "Nytrix task id: check, run, expand, trace, dump-ast, dump-llvm, dump-stats, format, analyze, tests, shapes, shape, profile.",
            "enum": [
              "check",
              "run",
              "expand",
              "trace",
              "dump-ast",
              "dump-llvm",
              "dump-stats",
              "format",
              "analyze",
              "tests",
              "shapes",
              "shape",
              "profile"
            ]
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "nytrix",
        "owner": "nytrix",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(?:\\[[^\\]]+\\]\\s+)?(?:(warning|error|note):?\\s+)?(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "configuration": {
      "title": "Nytrix",
      "properties": {
        "nytrix.path": {
          "type": "string",
