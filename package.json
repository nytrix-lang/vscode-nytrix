          "type": "boolean",
          "default": true,
          "description": "Reuse one Nytrix integrated terminal for run/test/profile commands instead of opening a new terminal every time."
        },
        "nytrix.repl.cwd": {
          "type": "string",
          "default": "",
          "description": "Working directory for the persistent Nytrix REPL. Empty uses the active workspace or file directory."
        },
        "nytrix.repl.arguments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Extra arguments appended after -i when starting the persistent Nytrix REPL."
        },
        "nytrix.repl.usePlain": {
          "type": "boolean",
          "default": false,
          "description": "Start the persistent REPL with --plain-repl for the simplest possible terminal behavior."
        },
        "nytrix.repl.revealTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the REPL terminal whenever the extension starts it or sends code into it."
        },
        "nytrix.check.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Use fallback compiler diagnostics on save only when ny-lsp is unavailable."
        },
        "nytrix.analyze.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Run ny-fmt analyzer hints on save and surface style / maintainability / optimization guidance alongside compiler diagnostics."
        },
        "nytrix.language.compilerParser.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Use the real Nytrix compiler parser (`ny --stop-after=parse --emit-artifact --emit-shapes`) for extension fallback symbols and type completions whenever `ny-lsp` is unavailable or still starting."
        },
        "nytrix.language.compilerParser.dirtyBuffers": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Also run the compiler parser on unsaved editor buffers for fallback symbols and semantic tokens. This keeps editor intelligence aligned with syntax changes while typing."
        },
        "nytrix.language.compilerParser.maxDirtyBytes": {
          "type": "number",
          "default": 200000,
          "minimum": 0,
          "markdownDescription": "Maximum unsaved buffer size parsed through the compiler fallback. `0` disables the size limit."
        },
        "nytrix.language.compilerParser.timeoutMs": {
          "type": "number",
          "default": 2500,
          "minimum": 250,
          "markdownDescription": "Timeout for compiler parser fallback requests. If parsing exceeds this budget, the extension keeps the last local/cache result instead of blocking editor features."
        },
        "nytrix.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Run/Check/Expand/REPL/Debug action lenses at the top of Nytrix files."
        },
        "nytrix.errorLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render inline Nytrix diagnostics after the affected line, alongside squiggles and Problems entries."
        },
        "nytrix.errorLens.includeHints": {
          "type": "boolean",
          "default": true,
          "description": "Include analyzer hints and notes in the inline Nytrix diagnostic lens, not just errors and warnings."
        },
        "nytrix.errorLens.maxItems": {
          "type": "number",
          "default": 40,
          "minimum": 0,
          "description": "Maximum inline Nytrix diagnostics to render in one editor at a time."
        },
        "nytrix.output.reveal": {
          "type": "string",
          "enum": [
            "errors",
            "always",
            "never"
          ],
          "default": "errors",
          "markdownDescription": "When to reveal the shared Nytrix output channel for extension-run commands. `errors` shows it only on failures unless a command explicitly needs streamed output."
        },
        "nytrix.output.clearBeforeRun": {
          "type": "boolean",
          "default": false,
          "description": "Clear the Nytrix output channel before each new command block instead of appending a timestamped history."
        },
        "nytrix.env": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables added to Nytrix tool processes."
