{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nytrix Markdown Code Blocks",
  "scopeName": "markdown.nytrix.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "name": "markup.fenced_code.block.markdown meta.embedded.block.nytrix",
      "begin": "(^|\\G)(\\s{0,3})(`{3,}|~{3,})\\s*(?:\\{?\\.?)?([nN][yY](?:[tT][rR][iI][xX])?)\\}?(?:\\s+[^`~]*)?$",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        },
        "4": {
          "name": "fenced_code.block.language.nytrix"
        }
      },
      "end": "(^|\\G)(\\s{0,3})(\\3)\\s*$",
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "patterns": [
        {
          "include": "source.nytrix"
        }
      ]
    }
  ]
}
